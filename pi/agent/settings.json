{
  "defaultModel": "gpt-5.6-sol",
  "defaultProvider": "openai-codex",
  "compaction": {
    "reserveTokens": 16384,
    "keepRecentTokens": 24000
  },
  "enabledModels": [
    "openai-codex/gpt-5.3-codex-spark",
    "openai-codex/gpt-5.5",
    "openai-codex/gpt-5.4",
    "openai-codex/gpt-5.4-mini",
    "minimax/MiniMax-M2.7-highspeed",
    "minimax/MiniMax-M3",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-terra"
  ],
  "lastChangelogVersion": "0.84.1",
  "packages": [
    "npm:pi-ask-user",
    "npm:pi-subagents",
    "npm:@alasano/pi-linear",
    "npm:@feniix/pi-exa",
    "npm:@feniix/pi-devtools",
    "npm:@feniix/pi-ref-tools",
    "npm:@feniix/pi-statusline",
    "npm:pi-codex-tools",
    "npm:@ff-labs/pi-fff"
  ],
  "pi-code-reasoning": {
    "maxBytes": 51200,
    "maxLines": 2000
  },
  "pi-exa": {
    "advancedEnabled": false,
    "enabledTools": [],
    "researchEnabled": false
  },
  "pi-ref-tools": {
    "maxBytes": 51200,
    "maxLines": 2000,
    "protocolVersion": "2025-06-18",
    "timeoutMs": 30000,
    "url": "https://api.ref.tools/mcp"
  },
  "pi-sequential-thinking": {
    "maxBytes": 51200,
    "maxLines": 2000,
    "storageDir": null
  },
  "defaultThinkingLevel": "high",
  "theme": "dark",
  "skills": [
    "!**/.agents/skills/**",
    "!**/synced/**"
  ]
}
